# VKON Attendance backend configuration (copy to .env and adjust).
# Every value below has a safe local-dev default baked into server/config.py;
# set these to override, and ALWAYS set strong values for production.

# Long random string used to sign short-lived MFA pre-auth tokens.
# Generate one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-secret

# dev | prod  (prod turns on secure-by-default cookie behaviour)
VKON_ENV=dev

# Cookie transmission. Secure cookies require TLS.
# Set true when serving over HTTPS (required in production), false for local http.
COOKIE_SECURE=false
# lax | strict | none
COOKIE_SAMESITE=lax

# Session lifetime (seconds). 30-minute sliding idle, 12-hour absolute cap.
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200

# Login throttling.
LOGIN_IP_WINDOW_SECONDS=60
LOGIN_IP_MAX=10
LOGIN_ID_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# Where the SQLite database lives (mount a volume here in Docker).
VKON_DB_PATH=./data/vkon.db
