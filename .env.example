# VKON Attendance -- example environment file.
#
# Copy this to `.env` (untracked, git-ignored and docker-ignored) and fill in
# real values there. Never put a secret in this file or commit one.
#
#   cp .env.example .env
#
# The current build serves the static front-end only and reads none of these
# values yet; they are declared here so that the deployment has exactly one
# place for configuration and no placeholder secret baked into the image or the
# repository.

# Deployment stage: development | production
VKON_ENV=production

# Where the container writes runtime data. It must stay outside the served
# docroot (/srv/public) so that no database file or photo is ever reachable
# over HTTP.
VKON_DATA_DIR=/var/lib/vkon

# --- Reserved for the authentication backend (not used by the static build) ---

# Secret used to sign session tokens. Leave blank here; generate a real value
# and put it only in .env:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Set true when the site is served over HTTPS so the session cookie is marked
# Secure. Keep false only for plain-http local access.
COOKIE_SECURE=true

# SQLite location. Must live under VKON_DATA_DIR, never inside the docroot.
VKON_DB_PATH=/var/lib/vkon/vkon.db
