# VKON Attendance -- example environment file.
#
# Copy this to `.env` (untracked, git-ignored and docker-ignored) and fill in
# real values there. Never put a secret in this file or commit one.
#
#   cp .env.example .env
#
# The static build (Dockerfile) reads none of these. The backend build
# (Dockerfile.backend) reads all of them, and refuses to start in production
# without a real SESSION_SECRET. Nothing here is a working value: fill them in
# only in .env.

# Deployment stage: development | production
VKON_ENV=production

# Where the container writes runtime data. It must stay outside the served
# docroot (/srv/public) so that no database file or photo is ever reachable
# over HTTP.
VKON_DATA_DIR=/var/lib/vkon

# --- Authentication backend ---------------------------------------------------

# Secret used to sign session tokens. Leave blank here; generate a real value
# and put it only in .env:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app will not start in production while this is empty.
SESSION_SECRET=

# Set true when the site is served over HTTPS so the session cookie is marked
# Secure. Keep false only for plain-http local access.
COOKIE_SECURE=true

# SQLite location. Must live under VKON_DATA_DIR, never inside the docroot.
VKON_DB_PATH=/var/lib/vkon/vkon.db

# The administrator login name, and optionally its password. With no password set
# here the backend generates one, writes it to data/initial-credentials.txt, prints
# where to find it once at boot, and forces a change on first sign-in. There is no
# default password in this repository -- see docs/backend.md for why.
VKON_ADMIN_USERNAME=admin
VKON_ADMIN_PASSWORD=

# Set true ONLY when a reverse proxy or Cloudflare Tunnel sits in front and rewrites
# the client address. Rate limiting then reads cf-connecting-ip; trusting that header
# from an untrusted network lets anyone forge an address and dodge the limit.
VKON_TRUST_PROXY_HEADERS=false

# --- PostgreSQL (deploy/compose.yml, scripts/db-*.mjs) ------------------------
#
# Two roles on purpose. The owner creates and migrates; the application connects as
# attendance_app, which has no CREATE, so a compromised API cannot add a trigger that
# quietly rewrites attendance history. The container's superuser is the owner: the
# image only bootstraps a database when its data directory is empty, so the owner must
# be POSTGRES_USER and attendance_app is created afterwards by scripts/db-setup.mjs.
#
# Generate every value below locally:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# None of them go in this file.

POSTGRES_DB=vkon_attendance
POSTGRES_OWNER_USER=
POSTGRES_OWNER_PASSWORD=
ATTENDANCE_APP_USER=attendance_app
ATTENDANCE_APP_PASSWORD=

# The same two credentials expressed as URLs, so a script never assembles one by hand
# and never has to guess whether a password contains a '#'.
DATABASE_URL_OWNER=
DATABASE_URL_APP=

# Local development only: the loopback port that deploy/compose.dev.yml publishes.
# It is not a production setting and production compose.yml publishes nothing.
DEV_DB_PORT=5433
