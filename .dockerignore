# Nothing below may ever enter the image. The container serves the public
# front-end only, so repository history, secrets, runtime data and the test
# suite are excluded here as well as by the explicit COPY list in the Dockerfile.

# Version control history (source + secret disclosure if it were ever served)
.git/
.gitignore

# Secrets and local configuration
.env
.env.*
!.env.example

# Runtime data: SQLite database, WAL sidecars, captured photos/selfies
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
photos/

# Local tooling / dependencies
.venv/
venv/
node_modules/
__pycache__/
*.pyc
.pytest_cache/

# Build output from whoever last ran the app locally. A stale .next/ in the build
# context is a second, older copy of the server inside the image.
.next/
out/
*.tsbuildinfo

# Scratch output from a test run pointed at VKON_TEST_DATA_DIR. It can contain a
# live SQLite database and a one-time credentials file.
.scratch/

# Backend source is NOT excluded here any more. Docker honours exactly one ignore
# file per build, and the backend image (Dockerfile.backend) needs server/ while
# the static image must not have it. The real control is that the static Dockerfile
# lists what it copies and never copies server/, and that the backend serves files
# from an explicit allow-list. See server/main.py PUBLIC_FILES.

# Tests and docs are not part of the served site. requirements.txt stays available:
# Dockerfile.backend installs from it, and the static image never reads it.
test_*.py
test_*.js
verify_*.py
tests/
docs/
deploy/
README.md
Dockerfile
Dockerfile.backend
Dockerfile.app
docker-compose.yml
.dockerignore

# Schema and operational scripts. Neither belongs in an image: migrations and role
# setup are run from the host's checkout against the database container, so a running
# container holds no copy of the schema it is writing to and no way to change it. A
# container that can migrate its own database is a container whose compromise is also
# a schema compromise.
db/
scripts/
