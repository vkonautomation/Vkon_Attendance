{
  "name": "vkon-attendance",
  "version": "1.0.0",
  "private": true,
  "description": "VKON Attendance portal: the API and the browser front end in one Next.js app.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vkonautomation/Vkon_Attendance.git"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f deploy/compose.yml -f deploy/compose.dev.yml --env-file .env up -d db",
    "db:down": "docker compose -f deploy/compose.yml -f deploy/compose.dev.yml --env-file .env down",
    "db:setup": "node scripts/db-setup.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:prepare": "npm run db:setup && npm run db:migrate && npm run db:seed",
    "test": "node scripts/run-tests.mjs",
    "test:fast": "node scripts/run-tests.mjs --no-serve",
    "test:probe": "node tests/probe.mjs",
    "test:guard": "node tests/guard.mjs",
    "test:unit": "node tests/unit/env.mjs",
    "test:conformance": "vitest run",
    "test:db": "node tests/integration/db.mjs",
    "test:auth": "node tests/integration/auth.mjs",
    "test:hardening": "node tests/integration/hardening.mjs",
    "bcrypt:calibrate": "node scripts/bcrypt-calibrate.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
